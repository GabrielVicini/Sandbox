{
  "manifest_version": 3,
  "name": "Schoology Pop-Out",
  "short_name": "SGY Pop-Out",
  "version": "1.0.0",
  "description": "Pop Schoology's tiny embedded external-tool (LTI) iframes out into a full window, tab, or maximized view.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Pop out Schoology embed",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [],
  "host_permissions": [
    "*://*.schoology.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.schoology.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
